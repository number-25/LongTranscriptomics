/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
number-25/LongTranscriptomics Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Default config options for all compute environments
----------------------------------------------------------------------------------------
 */
//Plugins
plugins {
    id 'nf-schema@2.5.1'
}

nextflow.enable.types = true

// Global default params, used in configs
params {
    // Input options
    input: Path
    sequencing_type: String            // sequencing library [ont-drna OR ont-cdna]
    bam_input: Boolean                 // input premapped bam files. default: [false]
    // References
    genome_fasta: Path                 //'data/hg38.analysisSet.fa.gz'
    genome_fasta_index: Path           //'data/hg38.analysisSet.fa.fai'
    genome_fasta_sizes: Path
    skip_prepare_reference: Boolean    // even if paths are hardcoded, files need to be unzipped and so on
    genome_minimap2_index: Path
    transcriptome_fasta: Path          // e.g. 'data/gencode.v46.transcripts.fa.gz'
    transcriptome_fasta_index: Path
    transcriptome_minimap2_index: Path
    annotation_gtf: Path               // e.g. 'data/Homo_sapiens.GRCh38.112.gtf.gz'
    //custom_genome: false             // only when providing novel genomes

    // MultiQC options
    multiqc_config: Path
    multiqc_title: String
    multiqc_logo: Path
    multiqc_methods_description: String
    //max_multiqc_email_size        = '25.MB'

    // QC
    skip_qc: Boolean
    skip_bam_qc: Boolean
    skip_alfred: Boolean
    skip_samtools_flagstat: Boolean
    //alfred_options
    //extra_alfred_options         : null
    skip_nanoq: Boolean
    //extra_nanoq_options
    skip_sequali: Boolean
    //extra_sequali_options
    skip_cramino: Boolean
    cramino_min_length: Integer // minimum read length to consider [default: 0]
    //extra_cramino_options
    skip_samtools_flagstat: Boolean
    skip_ngs_bits: Boolean
    ngs_bits_skip_contamination: Boolean // default: [Boolean]
    ngs_bits_build: String // options: [hg38, hg19, non_human]
    //extra_ngs_bits_options         : null

    // MAPPING
    transcriptome_mapping: Boolean
    // minimap2 options
    skip_mapping: Boolean
    //extra_minimap2_options          = null

    // BAM to BIGWIG
    skip_bam_to_bigwig: Boolean

    // TRANSCRIPT RECONSTRUCTION
    // FLAIR
    skip_flair: Boolean
    skip_flair_correct: Boolean
    extra_flair_correct_options: String
    skip_flair_collapse: Boolean
    extra_flair_collapse_options: String
    // BAMBU
    skip_bambu: Boolean
    extra_bambu_options: String
    // STRINGTIE2
    skip_stringtie: Boolean
    extra_stringtie_options: String
    // ISOQUANT
    skip_isoquant: Boolean
    skip_isoquant_correction: Boolean
    extra_isoquant_options: String

    // TRANSCRIPTOME QC
    skip_jaccard: Boolean
    skip_gffcompare: Boolean
    extra_gffcompare_options: String
    // SQANTI
    skip_sqanti_all: Boolean
    skip_sqanti_qc: Boolean
    sqanti_qc_reference: Path
    sqanti_qc_cage: Boolean
    sqanti_qc_cage_path: Path // path to cage data
    sqanti_qc_polyA_sites: Boolean
    sqanti_qc_polyA_sites_path: Path // path to polyA sites data
    sqanti_qc_polyA_motif: Boolean
    sqanti_qc_polyA_motif_path: Path // path to polyA motif data
    sqanti_qc_intron_junctions: Boolean
    sqanti_qc_intron_path: Path // path to intron junction data
    extra_sqanti_qc_options: String
    // skip_sqanti_filter          : Boolean
    // extra_sqanti_filter_options : String
    // skip_sqanti_recover         : Boolean
    // extra_sqanti_recover_options: String

    // FUSION GENE DETECTION
    // JAFFAL
    skip_jaffal: Boolean
    skip_jaffal_download: Boolean
    jaffal_reference: Path

    // TRANSCRIPT QUANTIFICATION
    skip_transcript_quantification: Boolean
    skip_oarfish: Boolean

    // CONTAMINATION / UNMAPPED READ PROFILING
    skip_sylph: Boolean
    sylph_database: Path //"data/gtdb-r226-c1000-dbv1.syldb"
    sylph_database_name: String //"GTDB_r226"

    // Boilerplate options
    outdir: String = "outputs"
    publish_dir_mode = 'copy'
    email: String
    plaintext_email: Boolean
    monochrome_logs: Boolean
    hook_url: String
    help: Boolean
    version: Boolean
    trace_timestamp = string \\ new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
    //pipelines_testdata_base_path  = 'https://raw.githubusercontent.com/nf-core/test-datasets/'

    // Config options
    config_profile_name: String
    config_profile_description: String
    custom_config_version: String
    custom_config_base: String
    config_profile_contact: String
    config_profile_url: String
}

